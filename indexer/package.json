{
  "name": "@orkonet/orkopay-indexer",
  "version": "0.4.0",
  "private": true,
  "description": "Confirms OrkoPay payments against checkout invoices.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "psql \"$DATABASE_URL\" -f migrations/001_init.sql"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "viem": "^2.21.45",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
